---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TreatmentArt from '../components/TreatmentArt.astro';

import { getCollection } from 'astro:content';
import { site } from '../data/site';

const treatments = await getCollection('treatments');

const stats = [
  { number: `${treatments.length}`, label: 'Treatments offered' },
  { number: '4',    label: 'Service families' },
  { number: '1', label: 'Artist, start to finish' },
];
---

<Layout
  title={`The studio | ${site.legalName}`}
  description={`${site.legalName} is a new permanent-makeup, skin and laser studio in ${site.city}, run by one artist — and the standards it opens with.`}
>
  <header class="page-header">
    <span class="page-header__eyebrow">About the studio</span>
    <h1>New in {site.city}, with standards from day one.</h1>
    <div class="page-header__rule"></div>
    <p class="page-header__lede">
      {site.legalName} is a permanent-makeup, skin and laser studio in {site.address.line2}, run by
      one artist, Roshni Verma. It is new — so instead of a history, here is what it promises.
    </p>
  </header>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        {/* Drawn art until there is a photograph of the real room (docs/specs/P10-no-spa.md). */}
        <div class="about-image" data-cat="skin">
          <TreatmentArt category="skin" />
        </div>

        <div class="about-content">
          <SectionHeading title="What the studio is for" subtitle="The idea" alignment="left" />
          <p>
            Permanent makeup shouldn't look like a tattoo — it should look like makeup applied by
            someone who knows your face, that simply never washes off. Skin treatments should change
            how your skin behaves over months, not how it looks for an afternoon. That is the whole
            idea, and every treatment on the menu is judged against it.
          </p>
          <p>
            Our philosophy is <strong>subtle enhancement</strong>. We don't work from one-size-fits-all
            stencils. Every set of brows and lips is mapped to your bone structure and your natural
            asymmetry — because faces aren't symmetrical, and results that pretend otherwise are the
            ones that look done.
          </p>
          <p>
            Four families of treatment — <strong>and the screening that has to come with them</strong>.
            Patch tests before laser. Dermatology clearance before any mole. A free consultation
            before anything at all.
          </p>

          <div class="stats-grid">
            {stats.map(stat => (
              <div class="stat">
                <span class="number">{stat.number}</span>
                <span class="label">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-offset">
    <div class="container values">
      <SectionHeading title="What we won't compromise on" subtitle="Standards" />
      <ul class="accent-list values-list">
        <li><strong>Sterility.</strong> Single-use needles, blades and laser tips, opened in front of you, and sharps disposal on site.</li>
        <li><strong>Honesty.</strong> If your skin, medication or expectations make a treatment a bad idea, we say so and don't take the booking.</li>
        <li><strong>Scope.</strong> One artist working strictly inside what she is trained for. Anything that needs a doctor is referred to one — we don't improvise near a diagnosis.</li>
        <li><strong>Evidence over speed.</strong> The faster option is often the one that causes rebound pigmentation. We treat in the order the evidence supports, even when it costs us the sale.</li>
        <li><strong>Patience.</strong> Mapping takes as long as it takes, and a skin course takes the months it takes. Nothing here is sold as a single-visit fix that isn't one.</li>
        <li><strong>Aftercare.</strong> Every client leaves with written instructions, and a way to reach the studio for the days that matter most.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta">
      <h2>Come and see for yourself.</h2>
      <p class="text-muted">The first consultation is free, and you can <a href="/studio">take a look around</a> first.</p>
      <a href="/contact" class="btn-primary">Book a free consultation</a>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .about-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .about-image {
    height: clamp(320px, 45vw, 520px);
  }

  .about-content p {
    font-size: 1.05rem;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  .about-content strong {
    color: var(--color-text);
    font-weight: 500;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-divider);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .number {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .values {
    max-width: 46rem;
  }

  .values-list li {
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .values-list li:last-child {
    border-bottom: 0;
  }

  .values-list strong {
    color: var(--color-text);
    font-weight: 500;
  }
  .cta { text-align: center; max-width: 36rem; }
  .cta h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 0.75rem; }
  .cta p { margin-bottom: 1.5rem; }
</style>
