---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { BOOK_LABEL } from '../lib/contact';
---

<Layout title={`Page not found | ${site.legalName}`} description="That page is not here. The treatments, prices and booking page are.">
  <section class="section">
    <div class="container lost">
      <span class="eyebrow">404</span>
      <h1>That page isn't here.</h1>
      <p class="text-muted">The link may be old or mistyped. Everything you might be looking for is one tap away.</p>
      <div class="actions">
        <a href="/treatments" class="btn-outline">Treatments</a>
        <a href="/prices" class="btn-outline">Prices</a>
        <a href="/contact" class="btn-primary">{BOOK_LABEL}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lost {
    max-width: 36rem;
    text-align: center;
    padding: clamp(2rem, 8vw, 6rem) 0;
  }

  .eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .lost h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
