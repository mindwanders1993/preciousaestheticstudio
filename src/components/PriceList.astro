---
/**
 * The whole menu with its prices, on one screen. A visitor deciding whether to
 * get in touch wants the price first; this answers it without a click, and every
 * line still leads to its treatment page.
 */
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';

const treatments = await getCollection('treatments');
const groups = categories
  .map(category => ({
    category,
    items: treatments
      .filter(t => t.data.category === category.id)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter(g => g.items.length > 0);
---

<div class="price-list">
  {groups.map(({ category, items }) => (
    <div class="price-group" data-cat={category.id}>
      <h3 class="price-group__title">{category.label}</h3>
      <ul class="price-group__items">
        {items.map(t => (
          <li>
            <a href={`/treatments/${t.id}`} class="price-row">
              <span class="price-row__name">{t.data.title}</span>
              <span class="price-row__leader" aria-hidden="true"></span>
              <span class="price-row__price">
                {t.data.price}
                {t.data.priceNote && <small>{t.data.priceNote.replace(/\.$/, '').toLowerCase()}</small>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .price-list {
    display: grid;
    gap: 2.5rem 4rem;
    max-width: 980px;
    margin: 0 auto;
  }

  @media (min-width: 800px) {
    .price-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .price-group__title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cat);
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .price-group__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0;
    color: var(--color-text);
  }

  .price-row__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .price-row:hover .price-row__name {
    color: var(--cat);
  }

  .price-row__leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--color-text-faint);
    transform: translateY(-0.3em);
  }

  .price-row__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .price-row__price small {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
</style>
